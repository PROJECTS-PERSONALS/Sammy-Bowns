# Plantilla de variables de entorno. Copia este archivo como ".env" y
# completa tus propios valores reales. NUNCA subas el archivo ".env" (con
# valores reales) a un repositorio público — ya está listado en .gitignore.

# Puerto en el que corre el servidor
PORT=4000

# Correo del administrador (el único que puede entrar al dashboard)
ADMIN_EMAIL=

# Hash bcrypt de la contraseña del administrador — NUNCA la contraseña en
# texto plano. Para generarlo:
#   node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 12))"
ADMIN_PASSWORD_HASH=

# Cadena aleatoria larga usada para firmar los tokens de sesión (JWT).
# Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión del administrador (formato aceptado por jsonwebtoken)
JWT_EXPIRES_IN=2h

# Dominios permitidos para consumir la API (separados por coma).
# En desarrollo local, agrega el puerto de tu servidor estático (Live Server,
# http-server, etc). En producción, agrega el dominio real de GitHub Pages,
# por ejemplo: https://tu-usuario.github.io
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
